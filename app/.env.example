# Cobalt: Firebase web config.
# Copy this file to `.env.local` and paste the values from your Firebase project
# (Project settings -> General -> Your apps -> SDK setup and configuration).
#
# Until these are set, the app automatically falls back to a local-only backend
# (in-memory + localStorage) so you can use Tasks + Focus without any backend.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: serverless AI proxy endpoint for emoji-picking niceties.
# Leave blank to disable AI features gracefully.
VITE_AI_PROXY_URL=
